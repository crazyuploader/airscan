    <string name="app_name">Airscan</string>
    <string name="access_title">Access</string>
    <string name="access_intro">Android hides cell and Wi-Fi details from apps that lack these. Airscan uses them only on your phone. It sends nothing anywhere.</string>
    <string name="access_precise_location">Precise location</string>
    <string name="access_precise_location_why">Needed for cell identity, neighbour cells, Wi-Fi names and the Wi-Fi scan list.</string>
    <string name="access_phone_state">Phone state</string>
    <string name="access_phone_state_why">Needed for the SIM list and per-SIM network details. Android words it as \"make and manage phone calls\". Airscan makes no calls.</string>
    <string name="access_location_switch">Location switch</string>
    <string name="access_location_switch_why">Android returns no Wi-Fi scan results while Location is off.</string>
    <string name="access_state_on">Allowed</string>
    <string name="access_state_needed">Needed</string>
    <string name="access_approximate">You chose approximate location. Android then hides cell and Wi-Fi details. Choose precise location to see them.</string>
    <string name="access_without">Without these, Airscan shows only signal strength and the 5G hint.</string>
    <string name="access_blocked">Android will not ask again. Open the app settings and allow the missing items.</string>
